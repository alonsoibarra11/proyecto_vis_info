# ============================================================
#  Plantilla de variables de entorno — proyecto_vis_info
#  Copia este archivo a .env:  cp .env.example .env
# ============================================================

# ---- Servidor estático (server.js) ----
PORT=8000
HOST=localhost
STATIC_ROOT=.

# ---- Entorno de ejecución ----
NODE_ENV=development

# ---- URLs y CDN del front-end ----
APP_BASE_URL=http://localhost:8000
PLOTLY_CDN=https://cdn.plot.ly/plotly-2.35.2.min.js
TONE_CDN=https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js
