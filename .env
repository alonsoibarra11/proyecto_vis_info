# ============================================================
#  Variables de entorno — proyecto_vis_info
#  (Mapa sonoro de estadios del mundo)
#  Copia este archivo a .env y ajusta los valores según tu entorno.
# ============================================================

# ---- Servidor estático (server.js) ----
# Puerto en el que escucha el servidor de previsualización.
PORT=8000

# Host/interfaz de escucha. Usa 0.0.0.0 para exponerlo en la red local.
HOST=localhost

# Directorio raíz que se sirve estáticamente. Por defecto la carpeta del proyecto.
STATIC_ROOT=.

# ---- Entorno de ejecución ----
# development | production
NODE_ENV=development

# ---- URLs y CDN del front-end ----
# URL base con la que se abre la app en el navegador.
APP_BASE_URL=http://localhost:8000

# CDN de las librerías (por si quieres fijar versiones o usar un mirror).
PLOTLY_CDN=https://cdn.plot.ly/plotly-2.35.2.min.js
TONE_CDN=https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js
